        paddingBottom={1}
      >
        <box backgroundColor={theme.backgroundElement} paddingLeft={1} paddingRight={1} marginRight={1}>
          <text fg={theme.textMuted} attributes={TextAttributes.BOLD}>BACKGROUND</text>
        </box>
