{
  "$schema": "https://dax.ai/config.json",
  "mcp": {
    "workspace_kernel": {
      // Copy this into your local .dax/dax.jsonc only after workspace-mcp is installed.
      "type": "local",
      "command": [
        // Update this to the installed workspace-mcp executable on your machine.
        "/absolute/path/to/workspace-mcp",
        "--workspace-root",
        // Point this at the repository you want DAX to serve through workspace-mcp.
        "/absolute/path/to/your/repo",
        "--profile",
        "dev"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "1"
      },
      "timeout": 30000
    }
  }
}
