{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "dax",
  "description": "DAX - governed execution with a deterministic runtime contract around stochastic model execution.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run --cwd packages/dax dev",
    "dax:local": "./script/dax-local.sh",
    "typecheck": "bun turbo typecheck",
    "typecheck:dax": "bun run --cwd packages/dax typecheck",
    "lint": "bun run --cwd packages/dax lint && bun run lint:workspaces",
    "lint:workspaces": "bun packages/dax/node_modules/eslint/bin/eslint.js --config packages/dax/eslint.config.js packages/plugin/src packages/util/src packages/script/src packages/sdk/js/src --suppressions-location eslint-workspaces-suppressions.json",
    "test": "bun run script/test.ts",
    "test:coverage": "bun run script/test.ts --coverage",
    "test:mutation:pilot": "stryker run packages/dax/stryker.pilot.conf.mjs",
    "test:mutation:pilot:ci": "CI=1 stryker run packages/dax/stryker.pilot.conf.mjs",
    "build": "bun --cwd packages/dax build",
    "check:repo": "bun run script/check-repo-integrity.ts",
    "guard:legacy": "bun run script/guard-legacy.ts",
    "release:check": "bun run script/release-check.ts",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "rust:verify": "bun run rust:fmt && bun run rust:clippy && bun run rust:test",
    "test:determinism": "cargo test -p dax-core",
    "demo:proof-ladder": "bun run script/demo-proof-ladder.ts",
    "eval:smoke": "bun run script/eval.ts --suite smoke",
    "eval:proof": "bun run script/eval.ts --suite proof",
    "eval": "bun run eval:smoke",
    "proof:check": "bun run rust:verify && bun run demo:proof-ladder && bun run release:check",
    "verify:hybrid": "bun run typecheck:dax && bun run test && bun run rust:verify",
    "release:gates": "bun run check:repo && bun run guard:legacy && bun run typecheck && bun run lint && bun run test && bun run eval:smoke && bun run rust:verify && bun run release:check",
    "release:verify": "bun run release:gates",
    "release": "bun run release:verify && bun run build",
    "release:publish": "DAX_RELEASE=1 bun run release",
    "release:publish:live": "DAX_RELEASE=1 DAX_RELEASE_DRAFT=0 DAX_RELEASE_PUBLISH=1 bun run release",
    "dist:homebrew": "bun run script/generate-homebrew-formula.ts",
    "dist:winget": "bun run script/generate-winget-manifest.ts"
  },
  "workspaces": {
    "packages": [
      "packages/dax",
      "packages/plugin",
      "packages/util",
      "packages/script",
      "packages/sdk/js"
    ]
  },
  "catalog": {
    "@types/bun": "1.3.8",
    "@hono/standard-validator": "0.2.3",
    "@hono/zod-validator": "0.4.2",
    "@octokit/rest": "22.0.0",
    "ulid": "3.0.1",
    "@kobalte/core": "0.13.11",
    "@types/luxon": "3.7.1",
    "@types/node": "22.13.9",
    "@types/semver": "7.7.1",
    "@tsconfig/node22": "22.0.2",
    "@tsconfig/bun": "1.0.9",
    "@cloudflare/workers-types": "4.20251008.0",
    "@pierre/diffs": "1.0.2",
    "@solid-primitives/storage": "4.3.3",
    "diff": "8.0.2",
    "dompurify": "3.3.1",
    "ai": "5.0.124",
    "hono": "4.12.29",
    "hono-openapi": "1.1.2",
    "fuzzysort": "3.1.0",
    "luxon": "3.6.1",
    "marked": "17.0.1",
    "marked-shiki": "1.2.1",
    "typescript": "5.8.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "zod": "4.1.8",
    "remeda": "2.26.0",
    "shiki": "3.20.0",
    "solid-list": "0.3.0",
    "tailwindcss": "4.1.11",
    "virtua": "0.42.3",
    "vite": "7.1.4",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.4",
    "solid-js": "1.9.10",
    "vite-plugin-solid": "2.11.10"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@tsconfig/bun": "catalog:",
    "esbuild": "^0.28.1",
    "prettier": "3.6.2",
    "turbo": "2.10.4"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "hono": "^4.12.29",
    "@hono/node-server": "^1.19.10",
    "@grpc/grpc-js": "^1.14.4",
    "axios": "^1.15.2",
    "seroval": "^1.5.4",
    "minimatch": "^10.2.1",
    "path-to-regexp": "^8.4.2",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.3.1",
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.9",
    "js-yaml": "^4.3.2",
    "picomatch": "^4.0.4",
    "undici": "^6.27.0",
    "form-data": "^4.0.6",
    "qs": "^6.15.3",
    "flatted": "^3.4.2",
    "lodash": "^4.17.24",
    "defu": "^6.1.7",
    "fast-xml-builder": "^1.1.9",
    "fast-xml-parser": "^5.7.3",
    "follow-redirects": "^1.16.0",
    "tmp": "^0.2.7",
    "diff": "^8.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaileshRawat1403/dax"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "patchedDependencies": {
    "gray-matter@4.0.3": "patches/gray-matter@4.0.3.patch"
  }
}
